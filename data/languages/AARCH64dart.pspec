<?xml version="1.0" encoding="UTF-8"?>
<!-- Physical names stay canonical for debugger mapping. Dart roles are aliases
     of the same registers, never a second register state. -->
<processor_spec>
  <properties>
    <property key="addressesDoNotAppearDirectlyInCode" value="true" />
    <property key="allowOffcutReferencesToFunctionStarts" value="false" />
    <property key="useNewFunctionStackAnalysis" value="true" />
    <property key="emulateInstructionStateModifierClass" value="ghidra.program.emulation.AARCH64EmulateInstructionStateModifier" />
    <property key="pcodeInjectLibraryClass" value="ghidart.DartPcodeInjectLibrary" />
    <property key="useropLibs" value="aarch64" />
  </properties>
  <programcounter register="pc" />
  <context_data>
    <context_set space="ram">
      <set name="ShowPAC" val="0" description="1 to show PAC operations in decompiler" />
      <set name="PAC_clobber" val="0" description="1 to let PAC operations overwrite their operands in decompiler" />
      <set name="ShowBTI" val="0" description="1 to show BTI effects in decompiler" />
      <set name="ShowMemTag" val="0" description="1 to show memory tag checks in decompiler" />
    </context_set>
  </context_data>
  <volatile outputop="cWrite" inputop="cRead">
    <range space="register" first="0x1000" last="0x2fff" />
  </volatile>
  <register_data>
    <!-- const Register ARGS_DESC_REG = R4;  // Arguments descriptor register. -->
    <register name="x4" alias="ARGS" />
    <register name="x15" alias="VMSP" />
    <register name="x16" alias="TMP" />
    <register name="x17" alias="TMP2" />
    <register name="x21" alias="GDT" />
    <register name="x22" alias="NULL" />
    <register name="x24" alias="CODE" />
    <register name="x26" alias="THR" />
    <register name="x27" alias="PP" />
    <register name="x28" alias="HBS" />
    <register name="x29" alias="FP" />
    <register name="x30" alias="LR" />
  </register_data>
</processor_spec>
